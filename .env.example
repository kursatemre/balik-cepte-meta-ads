# Meta for Developers > App Settings > Basic (API auth icin kullanilan app)
META_APP_ID=
META_APP_SECRET=

# Business Settings > Users > System Users > Generate Token
# Gerekli izinler: ads_management, ads_read
# Bu token act_244832992826003 hesabina scoped olmali.
META_ACCESS_TOKEN=

# Yonetilecek reklam hesabi (act_ onekiyle birlikte)
META_AD_ACCOUNT_ID=act_244832992826003

# Balik Cepte Facebook Page ID (App Promotion kampanyalari icin)
META_PAGE_ID=190068084900577

# App Events'in aktigi Facebook App ID (Events Manager > Data Sources'ta gorunen app).
# META_APP_ID ile ayni olabilir ama farkli da olabilir - Events Manager'dan teyit et.
META_PROMOTED_APP_ID=

# iOS App Store sayfasi (promoted_object.object_store_url icin)
META_APP_STORE_URL=https://apps.apple.com/tr/app/id6765955082
